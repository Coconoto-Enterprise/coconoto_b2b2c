{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/seo?action=sitemap" },
    { "source": "/blog/:id", "destination": "/api/seo?action=blog-meta&id=:id" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
