{
  "redirects": [
    { "source": "/services", "destination": "/cocotech", "permanent": true },
    { "source": "/services/:path*", "destination": "/cocotech/:path*", "permanent": true },
    { "source": "/product", "destination": "/cococycle-hub", "permanent": true },
    { "source": "/product/:path*", "destination": "/cococycle-hub/:path*", "permanent": true },
    { "source": "/marketplace", "destination": "/cococonnect", "permanent": true },
    { "source": "/marketplace/:path*", "destination": "/cococonnect/:path*", "permanent": true },

    { "source": "/figma/home", "destination": "/", "permanent": true },
    { "source": "/figma/about", "destination": "/about", "permanent": true },
    { "source": "/figma/equipment", "destination": "/cocotech", "permanent": true },
    { "source": "/figma/cococycle-hub", "destination": "/cococycle-hub", "permanent": true },
    { "source": "/figma/contact", "destination": "/contact", "permanent": true },
    { "source": "/figma/login", "destination": "/buyer-login", "permanent": true },
    { "source": "/figma/signup", "destination": "/buyer-signup", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/seo?action=page-meta&path=/" },

    { "source": "/sitemap.xml", "destination": "/api/seo?action=sitemap" },
    { "source": "/Sitemap.xml", "destination": "/api/seo?action=sitemap" },
    { "source": "/sitemap.XML", "destination": "/api/seo?action=sitemap" },
    { "source": "/SITEMAP.XML", "destination": "/api/seo?action=sitemap" },
    { "source": "/sitemap.xml/", "destination": "/api/seo?action=sitemap" },

    { "source": "/blog/:id", "destination": "/api/seo?action=blog-meta&id=:id" },

    { "source": "/about", "destination": "/api/seo?action=page-meta&path=/about" },
    { "source": "/cocotech", "destination": "/api/seo?action=page-meta&path=/cocotech" },
    { "source": "/cococycle-hub", "destination": "/api/seo?action=page-meta&path=/cococycle-hub" },
    { "source": "/cococonnect", "destination": "/api/seo?action=page-meta&path=/cococonnect" },
    { "source": "/shop", "destination": "/api/seo?action=page-meta&path=/shop" },
    { "source": "/blog", "destination": "/api/seo?action=page-meta&path=/blog" },
    { "source": "/contact", "destination": "/api/seo?action=page-meta&path=/contact" },
    { "source": "/help-center", "destination": "/api/seo?action=page-meta&path=/help-center" },
    { "source": "/privacy-policy", "destination": "/api/seo?action=page-meta&path=/privacy-policy" },
    { "source": "/terms-of-service", "destination": "/api/seo?action=page-meta&path=/terms-of-service" },
    { "source": "/cookie-policy", "destination": "/api/seo?action=page-meta&path=/cookie-policy" },

    { "source": "/api/delete-record", "destination": "/api/admin?action=delete-record" },
    { "source": "/api/update-status", "destination": "/api/admin?action=update-status" },
    { "source": "/api/update-price", "destination": "/api/admin?action=update-price" },

    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/api/seo?action=not-found&path=/$1" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
