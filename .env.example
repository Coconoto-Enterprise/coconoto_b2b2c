VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. Required by /api/email-data and by the email_logs write path in
# /api/send-email and /api/send-custom-email.
#
# WHY: 20260818000003_lock_pii_tables_and_policies_v3.sql revoked every
# privilege on `email_logs` and `email_sender_config` from `anon`, so anything
# touching those tables with the anon key now fails with 42501
# ("permission denied for table email_logs"). Never expose this key to the
# browser — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Clerk (CoCo-Connect sign in / sign up) ───────────────────────────────────
# Both are optional. With no publishable key the auth screens keep using the
# original /api/auth email+password flow, so the site works either way.
#
# VITE_* is inlined into the browser bundle by Vite — publishable key only.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
#
# Server-only, never VITE_. Used by the `clerk-session` action in /api/auth to
# verify the session JWT before minting the marketplace cookie.
CLERK_SECRET_KEY=sk_test_your_secret_key

# ── Analytics (Microsoft Clarity: heatmaps + session recordings) ─────────────
# Optional. Leave empty and no script is loaded, no cookie is set and no request
# leaves the browser — the site behaves exactly as it does today.
#
# Get the id from clarity.microsoft.com → Settings → Overview (a 10-char string
# like "k3j9x2abcd"). Vite inlines it at build time, so it has to be set in the
# Vercel environment *before* the build, not after.
#
# Read src/lib/analytics.ts before switching this on: dashboard routes are
# excluded from recording, but a session that starts on a public page and then
# navigates into a dashboard will keep recording it.
VITE_CLARITY_ID=
